// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserCategory {
  PELAJAR_SMA_SMK
  MAHASISWA
  FRESH_GRADUATE
  BEKERJA
  TIDAK_BEKERJA
  UMUM
  LAINNYA
}

enum CurrentStatus {
  PELAJAR_SMA_SMK  // Pelajar SMA atau SMK
  MAHASISWA        // Mahasiswa aktif
  FRESH_GRADUATE   // Lulusan baru
  BEKERJA          // Sedang bekerja
  TIDAK_BEKERJA    // Tidak/belum bekerja
}

enum EducationLevel {
  SMA
  SMK
  D3
  D4
  S1
  S2
  S3
  PROFESI
}

enum EducationStatus {
  LULUS
  SEDANG_DITEMPUH
}

enum WorkType {
  FORMAL
  SERABUTAN
  WIRAUSAHA
  FREELANCE
  PNS
  TNI_POLRI
  MAGANG
  SUKARELAWAN
  IRT
  TIDAK_BEKERJA
}

enum SkillCategory {
  TEKNIS
  NON_TEKNIS
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TechSavvyLevel {
  RENDAH
  MENENGAH
  TINGGI
  SANGAT_TINGGI
}

enum ITBackgroundLevel {
  NOL
  MINIM
  ADA
  KUAT
}

enum LearningStyle {
  VISUAL
  AUDITORI
  PRAKTIK_LANGSUNG
  MEMBACA_MENULIS
}

enum WorkEnvPreference {
  INDIVIDU
  TIM_KECIL
  TIM_BESAR
  FLEKSIBEL
}

enum CompanyTypePreference {
  STARTUP
  KORPORAT
  FREELANCE
  TECH_COMPANY
  BELUM_TERPIKIRKAN
}

enum WeeklyHoursRange {
  LESS_THAN_5   
  FIVE_TO_10   
  TEN_TO_20     
  MORE_THAN_20 
}

enum MonthlyIncomeRange {
  LESS_THAN_1M  
  ONE_TO_3M     
  THREE_TO_7M   
  SEVEN_TO_12M  
  MORE_THAN_12M 
}

enum AssessmentPath {
  NON_TEKNIS
  TEKNIS
}

enum WorkPersonality {
  SI_PRAKTIS
  SI_PEMIKIR
  SI_KREATIF
  SI_PENOLONG
  SI_PEMIMPIN
  SI_TERATUR
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum RecommendationStatus {
  ACTIVE
  ARCHIVED
}

enum RoadmapStatus {
  ACTIVE
  COMPLETED
  REPLACED
}

enum EvaluationStatus {
  PENDING
  COMPLETED
}

enum AdjustmentType {
  SCHEDULE_SPEED
  REORDER_MATERIAL
  ADD_MATERIAL
  CHANGE_CAREER
}

enum AdjustmentDecision {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  EVALUATION_REMINDER
  ADJUSTMENT_PROPOSAL
}

enum NotificationStatus {
  UNREAD
  READ
}


model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  birthDate    DateTime?
  phone        String?
  category     UserCategory?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  profile               UserProfile?
  refreshTokens         RefreshToken[]
  cvUploads             CvUpload[]
  educationHistories    EducationHistory[]
  workExperiences       WorkExperience[]
  skills                UserSkill[]
  assessmentSessions    AssessmentSession[]
  recommendationSessions RecommendationSession[]
  activeRoadmap         Roadmap?               @relation("ActiveRoadmap")
  roadmaps              Roadmap[]
  evaluations           PeriodicEvaluation[]
  adjustmentProposals   AdjustmentProposal[]
  notifications         Notification[]

  @@map("users")
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStatus   CurrentStatus?
  statusSince     DateTime?      
  currentJobTitle String?        
  currentJobDesc  String?        
  institutionName String?        

  techSavvyLevel    TechSavvyLevel?
  itBackgroundLevel ITBackgroundLevel?

  itBackground     Boolean?
  itBackgroundNote String?

  learningStyle         LearningStyle?
  workEnvPreference     WorkEnvPreference?
  companyTypePreference CompanyTypePreference?
  weeklyHoursRange      WeeklyHoursRange?
  weeklyHours           Int?                   
  preferredStudyTime    String[]               
  monthlyIncome         MonthlyIncomeRange?

  assessmentPath  AssessmentPath?
  workPersonality WorkPersonality?

  eventRoleInterest String?
  leisureInterest   String[]
  challengeAttitude String?
  itFieldInterest String[]
  mainMotivation  String[]

  itInterests     String[]
  extractedSkills String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

model EducationHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level     EducationLevel
  major     String
  status    EducationStatus
  semester  Int?           
  yearGraduated Int?        
  institution   String?    

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("education_histories")
}

model WorkExperience {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workType    WorkType
  jobTitle    String
  companyName String?  
  duration    String   
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("work_experiences")
}

model UserSkill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  category SkillCategory
  level    SkillLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("user_skills")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model CvUpload {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName     String
  fileUrl      String
  publicId     String?
  extractedRaw Json?
  isReviewed   Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("cv_uploads")
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  key           String   @unique
  text          String
  helpText      String?
  inputType     String  
  maxSelections Int?
  order         Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  options AssessmentOption[]
  answers AssessmentAnswer[]

  @@map("assessment_questions")
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label           String
  value           String
  order           Int
  nextQuestionKey String?

  createdAt DateTime @default(now())

  @@map("assessment_options")
}

model AssessmentSession {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status AssessmentStatus @default(IN_PROGRESS)

  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assessment_sessions")
}

model AssessmentAnswer {
  id        String            @id @default(cuid())
  sessionId String
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId  String
  question    AssessmentQuestion @relation(fields: [questionId], references: [id])
  questionKey String
  answerValue String

  createdAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@map("assessment_answers")
}

model RecommendationSession {
  id     String               @id @default(cuid())
  userId String
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status RecommendationStatus @default(ACTIVE)

  recommendations CareerRecommendation[]

  createdAt DateTime @default(now())

  @@map("recommendation_sessions")
}

model CareerRecommendation {
  id        String                @id @default(cuid())
  sessionId String
  session   RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  rank             Int
  professionTitle  String
  readinessPercent Int

  skills            Json

  reasonSummary     String
  professionOverview Json

  isSelected Boolean @default(false)

  roadmaps Roadmap[]

  @@map("career_recommendations")
}

model Roadmap {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation   CareerRecommendation @relation(fields: [recommendationId], references: [id])
  status           RoadmapStatus        @default(ACTIVE)

  activeForUserId String? @unique
  activeForUser   User?   @relation("ActiveRoadmap", fields: [activeForUserId], references: [id])

  weeklyHoursAtCreation Int

  materials           RoadmapMaterial[]
  evaluations         PeriodicEvaluation[]
  adjustmentProposals AdjustmentProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roadmaps")
}

model RoadmapMaterial {
  id        String  @id @default(cuid())
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  order       Int
  phase       String
  title       String
  description String?
  scheduledAt DateTime?
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roadmap_materials")
}

model PeriodicEvaluation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId String
  roadmap   Roadmap          @relation(fields: [roadmapId], references: [id])
  status    EvaluationStatus @default(PENDING)

  completedMaterials     Int
  totalMaterials         Int
  readinessPercentAtEval Int

  paceComfort          String?
  interestShifted      Boolean?
  timeAvailabilityNote String?
  freeNotes            String?

  proposedAdjustments AdjustmentProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("periodic_evaluations")
}

model AdjustmentProposal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roadmapId  String
  roadmap    Roadmap @relation(fields: [roadmapId], references: [id])

  evaluationId       String?
  evaluation         PeriodicEvaluation? @relation(fields: [evaluationId], references: [id])
  triggeredByAdvisor Boolean             @default(false)

  type        AdjustmentType
  decision    AdjustmentDecision @default(PENDING)
  description String
  payload     Json

  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("adjustment_proposals")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  status   NotificationStatus @default(UNREAD)
  title    String
  body     String
  metadata Json?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@map("notifications")
}
